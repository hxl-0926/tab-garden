{
  "manifest_version": 3,
  "name": "Tab Garden · 标签花园",
  "version": "0.1.0",
  "description": "整理标签页、保存阅读清单、恢复会话，再随机挑一篇收藏来读。数据只存在本机。",
  "minimum_chrome_version": "120",
  "permissions": ["tabs", "storage", "tabGroups"],
  "background": { "service_worker": "src/background.mjs", "type": "module" },
  "action": { "default_title": "打开标签花园", "default_icon": { "16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png" } },
  "icons": { "16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
